# Copie para .env e configure SEM enviar o arquivo ao Git/Copilot.
DT_ENV_URL=https://SEU-AMBIENTE.apps.dynatrace.com
# Método mais simples: token de plataforma (com read/write documentos)
DT_PLATFORM_TOKEN=COLE_SEU_PLATFORM_TOKEN_AQUI
# Alternativa corporativa OAuth client credentials: deixe DT_PLATFORM_TOKEN vazio
# DT_OAUTH_CLIENT_ID=
# DT_OAUTH_CLIENT_SECRET=
# DT_OAUTH_SCOPES=document:documents:read document:documents:write
# Sem valor 1, nenhuma publicação é possível.
DT_ALLOW_WRITE=0
# Opcional: DT_BACKUP_DIR=C:/caminho/seguro/backups
